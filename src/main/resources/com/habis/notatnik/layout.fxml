<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.habis.notatnik.Layout"
            prefHeight="400.0" prefWidth="600.0"
            >
    <top>
        <MenuBar>
            <Menu text="Plik">
                <MenuItem text="Otwórz" onAction="#otworzPlik"/>
                <MenuItem text="Zapisz" onAction="#zapiszPlik"/>
            </Menu>
        </MenuBar>
    </top>
    <center>
        <HBox>
            <VBox>
                <ListView fx:id="pointList"/>
            </VBox>
            <TextArea fx:id="textArea" wrapText="true"/>
        </HBox>
    </center>
</BorderPane>